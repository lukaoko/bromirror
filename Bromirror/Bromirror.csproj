<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bromirror</AssemblyName>
    <RootNamespace>Bromirror</RootNamespace>
    <ApplicationIcon>bromirror.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>Bromirror</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="bromirror.ico" />
  </ItemGroup>

</Project>
